<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/list_an_item"
            android:textColor="@color/text_main"
            android:textSize="28sp"
            android:fontFamily="sans-serif-black"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/sell_something"
            android:textColor="@color/text_muted"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/etItemTitle"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="25dp"
            android:hint="@string/item_title_required"
            android:background="@drawable/bg_marketplace_input"
            android:paddingHorizontal="16dp"/>

        <EditText
            android:id="@+id/etItemDescription"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="@string/description_required"
            android:background="@drawable/bg_marketplace_input"
            android:padding="16dp"/>

        <EditText
            android:id="@+id/etItemPrice"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:inputType="numberDecimal"
            android:hint="@string/price_required"
            android:background="@drawable/bg_marketplace_input"
            android:paddingHorizontal="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/category"
            android:textColor="@color/text_main"
            android:textSize="13sp"/>

        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:entries="@array/marketplace_categories"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/condition"
            android:textColor="@color/text_main"
            android:textSize="13sp"/>

        <Spinner
            android:id="@+id/spinnerCondition"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:entries="@array/marketplace_conditions"/>

        <EditText
            android:id="@+id/etItemImage"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="@string/image_url"
            android:inputType="textUri"
            android:background="@drawable/bg_marketplace_input"
            android:paddingHorizontal="16dp"/>

        <EditText
            android:id="@+id/etItemLocation"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:hint="@string/location_campus"
            android:background="@drawable/bg_marketplace_input"
            android:paddingHorizontal="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublishItem"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="25dp"
            android:text="@string/publish_listing"
            android:textColor="@color/white"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="18dp"/>

    </LinearLayout>

</ScrollView>
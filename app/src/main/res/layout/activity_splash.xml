<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_background">

    <!-- Logo Card -->

    <LinearLayout
        android:id="@+id/logoContainer"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_logo"
        android:gravity="center"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="180dp">

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/ic_school"
            app:tint="@android:color/white"/>

    </LinearLayout>

    <!-- College Name -->

    <TextView
        android:id="@+id/txtCollege"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ROSEBANK INTERNATIONAL NMB"
        android:fontFamily="@font/poppins_medium"
        android:textColor="#AEBBE7"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/logoContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="28dp"/>

    <!-- Campus -->

    <TextView
        android:id="@+id/txtCampus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Campus"
        android:fontFamily="@font/poppins_bold"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:textSize="26sp"
        app:layout_constraintTop_toBottomOf="@id/txtCollege"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Companion -->

    <TextView
        android:id="@+id/txtCompanion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Companion"
        android:fontFamily="@font/poppins_bold"
        android:textStyle="bold"
        android:textSize="26sp"
        android:textColor="#E7B84A"
        app:layout_constraintTop_toBottomOf="@id/txtCampus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Bottom Section -->

    <LinearLayout
        android:id="@+id/indicatorLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/tagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="18dp">

        <View
            android:layout_width="24dp"
            android:layout_height="6dp"
            android:background="@drawable/indicator_active"/>

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/indicator_inactive"/>

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/indicator_inactive"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your academic life, simplified"
        android:fontFamily="@font/poppins_medium"
        android:textColor="#AEBBE7"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="70dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>